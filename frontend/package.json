{
  "name": "ktru-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format:check": "biome format .",
    "format": "biome check --write .",
    "api:generate": "openapi-typescript ../openapi.json -o src/shared/api/schema.gen.ts",
    "rules": "node scripts/checks.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run rules && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "clsx": "^2.1.1",
    "i18next": "^25.6.0",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.10.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^3.2.0"
  }
}
