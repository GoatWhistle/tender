FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
WORKDIR /app/qwen
COPY services/qwen/requirements.strict.lock.txt /app/qwen/requirements.strict.lock.txt
RUN pip install --no-cache-dir -r requirements.strict.lock.txt
COPY services/qwen/strict_api.py /app/qwen/strict_api.py
COPY services/qwen/model-manifest.json /app/qwen/model-manifest.json
COPY services/qwen/profiles/ /app/qwen/profiles/
RUN useradd --uid 10001 --create-home service
USER service
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python", "-m", "uvicorn", "strict_api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--limit-concurrency", "32"]
