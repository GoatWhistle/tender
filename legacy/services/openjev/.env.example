# Скопируйте в .env корня репозитория; compose.yaml читает эти значения. Секреты не нужны.
OPENJEV_BIND_ADDRESS=127.0.0.1
OPENJEV_PORT=8000
OPENJEV_MAX_TOKENS=4096
OPENJEV_MAX_BATCH=32
OPENJEV_MICROBATCH=4
OPENJEV_MICROBATCH_TOKENS=16384
OPENJEV_QUEUE_SIZE=8
OPENJEV_REQUEST_TIMEOUT=120
OPENJEV_MAX_BODY_BYTES=1048576
OPENJEV_CACHE_ENTRIES=8
OPENJEV_CACHE_BYTES=1073741824
OPENJEV_CACHE_TOKENS=32768
OPENJEV_CACHE_TTL=300
