# Скопировать в backend/.env и заполнить. Без EMBEDDINGS_URL приложение стартует,
# а POST /api/v1/search отвечает 503 model_not_configured.

# OpenAI-совместимый сервис эмбеддингов, адрес без пути (/v1/embeddings добавит адаптер).
EMBEDDINGS_URL=http://embeddings.example:8089
# Bearer-токен сервиса, если он нужен.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B
