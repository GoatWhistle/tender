# URL уже работающего OpenAI-совместимого сервиса Qwen; веса бэкенд не скачивает.
EMBEDDINGS_URL=http://127.0.0.1:18083/v1
EMBEDDINGS_MODEL=qwen-embedding
EMBEDDINGS_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
EMBEDDINGS_DIMENSION=1024
# Необязательный ключ; реальное значение храните только в локальном .env.
# EMBEDDINGS_API_KEY=replace-with-local-key
# DATABASE_URL=sqlite:////absolute/path/to/repository/var/tender.db

# Необязательное сопоставление enum-значений через отдельный OpenJev-сервис.
# При отсутствии URL остаётся детерминированный анализ; заглушка не подставляется.
DECISION_URL=http://127.0.0.1:18080
DECISION_TIMEOUT=120
# Продуктовый порог сырой оценки модели, не гарантия процента правильных ответов.
DECISION_AUTO_ACCEPT_ENABLED=true
DECISION_AUTO_ACCEPT_THRESHOLD=0.90
DECISION_REVISION=a20448012c213128955ca0c693e7c943865cab77
# Отчёт: evals/reports/2026-10-10-enum-mapping.md. Для ручного режима задайте enabled=false.
# Тот же OpenJev отсеивает тексты не о товаре; без него — только порог косинуса.
# SEARCH_MIN_SIMILARITY=0.45

# Орфографические предложения Qwen (не меняют исходный текст).
# Без URL API сообщает о неполной орфографической проверке.
# SPELLING_URL=http://127.0.0.1:18084/v1
# SPELLING_MODEL=qwen
# SPELLING_API_KEY=replace-with-local-key

# Число разных групп для обязательной проверки назначения через DECISION_URL: 5 или 10.
GROUP_TOP_K=10
