# URL уже работающего OpenAI-совместимого сервиса Qwen; веса бэкенд не скачивает.
EMBEDDINGS_URL=http://127.0.0.1:18083/v1
EMBEDDINGS_MODEL=qwen-embedding
EMBEDDINGS_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
EMBEDDINGS_DIMENSION=1024
# Необязательный ключ; реальное значение храните только в локальном .env.
# EMBEDDINGS_API_KEY=replace-with-local-key
# DATABASE_URL=sqlite:////absolute/path/to/repository/var/tender.db
# Орфографические предложения Qwen (не меняют исходный текст).
# Без URL API сообщает о неполной орфографической проверке.
# SPELLING_URL=http://127.0.0.1:18084/v1
# SPELLING_MODEL=qwen
# SPELLING_API_KEY=replace-with-local-key
